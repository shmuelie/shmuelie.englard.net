    "description": "Personal Website",
    "devDependencies": {
        "@awesome.me/webawesome": "3.5.0",
        "@playwright/test": "1.62.1",
        "@types/node": "^22.10.0",
        "del": "8.0.1",
        "dompurify": "3.4.13",
        "gulp": "5.0.1",
        "gulp-clean-css": "4.3.0",
        "gulp-sass": "6.0.1",
        "gulp-sourcemaps": "3.0.0",
        "gulp-terser": "2.1.0",
        "gulp-typescript": "5.0.1",
        "hashed-es6": "1.0.3",
        "http-server": "14.1.1",
        "jsdom": "29.0.1",
        "jsdom-global": "3.0.2",
        "lit": "3.3.2",
        "microdata-tooling": "1.0.4",
        "plugin-error": "2.0.1",
        "sass": "1.98.0",
        "shieldsio-elements": "1.1.1",
        "terser": "5.46.1",
        "through2": "4.0.2",
        "typescript": "5.9.3"
    },
    "displayName": "Shmueli Englard Personal Site",
    "homepage": "shmuelie.englard.net",
    "license": "./LICENSE",
    "name": "static.shmuelie.englard.net",
    "packageManager": "pnpm@10.34.5",
    "pnpm": {
        "ignoredBuiltDependencies": [
            "@parcel/watcher",
            "es5-ext",
            "hashed-es6",
            "microdata-tooling",
            "shieldsio-elements"
        ]
    },
    "private": true,
    "readme": "./README.md",
    "repository": {
        "type": "git",
        "url": "https://github.com/shmuelie/shmuelie.englard.net"
    },
    "scripts": {
        "build": "gulp --gulpfile gulpfile.mts build",
        "clean": "gulp --gulpfile gulpfile.mts clean",
        "postinstall": "gulp --gulpfile gulpfile.mts generateNodeModulePathMappings",
        "preinstall": "npx -y only-allow pnpm",
        "test": "tsc -p tsconfig.test.json && node test/prepare.mjs && node test/run.mjs",
        "test:e2e": "playwright test",
        "test-server": "http-server ./dist/ -p 8000 -e htm"
    },
    "version": "1.0.0"
}